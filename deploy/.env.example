# AllInOne v2 单容器部署环境变量。复制为 deploy/.env（已 gitignore）。
# 旧变量（DATABASE_URL/BASE_PATH/PORTAL_URL/ALLINONE_SITE）已全部废除。

TZ=Asia/Shanghai

# 对外端口（宿主机）
ALLINONE_PORT=8080

# 数据目录（NAS 实际路径）。首次部署前创建并授权：
#   mkdir -p /volume3/docker/allinone/data
#   chown -R 1000:1000 /volume3/docker/allinone/data
# 数据文件：/data/cdk/cdk.db 与 /data/tickersentry/ticker.db
# ALLINONE_DATA_DIR=/volume3/docker/allinone/data

# 可选：HTTPS 反代或非默认端口访问时，设置对外来源（scheme://host[:port]，不含路径）
# PUBLIC_ORIGIN=
