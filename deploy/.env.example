# AllInOne 部署环境变量示例。复制为 deploy/.env（已 gitignore）并填入实际值。
# 密钥与连接串只存在于 NAS 的 .env 中，不进入 Git（PRD §10.2/§11.1）。

TZ=Asia/Shanghai

# 网关对外端口
ALLINONE_PORT=8080

# 站点地址（Caddy）：默认 :8080；启用 HTTPS 时改为域名，例如 https://tools.nas.example.com
# 注意：改域名后需同步设置 TICKER_PUBLIC_ORIGIN（下面）。
# ALLINONE_SITE=:8080

# 健康检查配置文件（容器内路径）；不含该文件时全部工具显示“未监测”
PORTAL_HEALTH_CONFIG=/config/health.json

# 门户对外地址（协议+域名+端口），供 TickerSentry“返回工具箱”链接。
# 与 ALLINONE_SITE 一致，例如 https://tools.example.com
# PORTAL_URL=

# CDK 台账 PostgreSQL 连接串（沿用现有实例，不迁移数据）
# CDK_DATABASE_URL=postgresql://user:密码@192.168.5.16:15432/cdk_ledger

# TickerSentry 数据目录（NAS 实际路径）。
# 迁移：旧容器停止后 cp -a /volume3/docker/tickersentry/ticker_data /volume3/docker/allinone/tickersentry
# 且 chown -R 65532:65532 /volume3/docker/allinone/tickersentry
# TICKER_DATA_DIR=/volume3/docker/allinone/tickersentry

# TickerSentry 公开来源（scheme://host[:port]，不带路径）。HTTPS 或非默认端口时必填，
# 用于表单来源校验；纯 HTTP 默认端口可不填。
# TICKER_PUBLIC_ORIGIN=
