# AllInOne 部署环境变量示例。复制为 deploy/.env（已 gitignore）并填入实际值。
# 密钥与连接串只存在于 NAS 的 .env 中，不进入 Git（PRD §10.2/§11.1）。

TZ=Asia/Shanghai

# 网关对外端口
ALLINONE_PORT=8080

# 站点地址（Caddy）：默认 :8080；启用 HTTPS 时改为域名
# ALLINONE_SITE=https://tools.nas.example.com

# 健康检查配置文件（容器内路径），不含该文件时全部工具显示“未监测”
PORTAL_HEALTH_CONFIG=/config/health.json

# ---- M2 接入时启用 ----
# CDK 台账 PostgreSQL 连接串
# CDK_DATABASE_URL=postgresql://user:密码@192.168.5.16:15432/cdk_ledger
# TickerSentry 数据目录（NAS 实际路径；切换时按 PRD §11.1 复制一份）
# TICKER_DATA_DIR=/volume3/docker/allinone/tickersentry
